{
	"plugins": ["typescript"],
	"categories": {
		"correctness": "off",
		"suspicious": "off",
		"pedantic": "off",
		"perf": "off",
		"style": "off",
		"restriction": "off",
		"nursery": "off"
	},
	"rules": {
		"max-depth": ["error", { "max": 4 }],
		"typescript/no-explicit-any": "error",
		"typescript/no-non-null-assertion": "error",
		"no-param-reassign": ["error", { "props": true }]
	}
}
